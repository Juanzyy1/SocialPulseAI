NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://socialpulse:CAMBIA_ESTA_CLAVE@localhost:5432/socialpulse_dev"

# Inicio de sesión con Google (opcional: las tres variables juntas o ninguna)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Clave para cifrar los tokens de redes sociales: 32 bytes aleatorios en base64.
# Genérala con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# URL del frontend (solo el origen, sin ruta). Opcional: sin ella, los callbacks de Google
# y YouTube responden como API (JSON o redirección al perfil).
# FRONTEND_URL=http://localhost:5173

# Proxies de confianza delante de la aplicación. OBLIGATORIA en producción.
# 0 = la app recibe las peticiones directamente; 1 = hay un proxy inverso delante (lo habitual).
# Un valor incorrecto rompe el límite de intentos por IP o permite falsificar la IP.
# TRUST_PROXY_HOPS=0