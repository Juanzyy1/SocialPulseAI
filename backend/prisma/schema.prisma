// Esquema de Prisma de SocialPulse AI.
// Nombres de tabla en snake_case plural (@@map); campos en camelCase.
// Las métricas se guardan en filas (una por cuenta, día y métrica) para que cada
// plataforma pueda tener las suyas sin mezclarlas. Su significado vive en el
// catálogo de métricas del código (src/analytics/metric-catalog.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OAuthProvider {
  GOOGLE
}

enum SocialPlatform {
  YOUTUBE
  INSTAGRAM
  TIKTOK
}

enum SocialAccountStatus {
  ACTIVE
  REVOKED
  ERROR
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  // Siempre en minúsculas: la normalización se hace en la capa de aplicación (Fase 3).
  email        String   @unique
  // Vacío si el usuario solo accede con Google.
  passwordHash String?
  // Se completa cuando el correo se verifica. Con Google, se marca al vincular.
  emailVerifiedAt DateTime?
  // Aceptación de los términos y la política de privacidad (versión del texto aceptada).
  termsAcceptedAt DateTime?
  termsVersion    String?
  
  displayName  String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  oauthIdentities OAuthIdentity[]
  sessions        Session[]
  socialAccounts  SocialAccount[]

  @@map("users")
}

model OAuthIdentity {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  provider       OAuthProvider
  providerUserId String
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_identities")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  // Solo se guarda el hash (SHA-256) del token; el token real vive en la cookie.
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model SocialAccount {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  platform          SocialPlatform
  // En YouTube, el ID del canal.
  platformAccountId String
  displayName       String?
  handle            String?
  avatarUrl         String?
  status            SocialAccountStatus @default(ACTIVE)
  connectedAt       DateTime            @default(now())
  lastSyncedAt      DateTime?

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential     SocialCredential?
  dailyMetrics   AccountDailyMetric[]
  totalSnapshots AccountTotalSnapshot[]
  syncRuns       SyncRun[]

  // Unicidad GLOBAL: un mismo canal no puede estar conectado por dos usuarios.
  @@unique([platform, platformAccountId])
  @@index([userId])
  @@map("social_accounts")
}

model SocialCredential {
  id              String   @id @default(uuid()) @db.Uuid
  socialAccountId String   @unique @db.Uuid
  // Cifrados con AES-256-GCM. Nunca se guardan en claro.
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime?
  scopes          String[]
  // Permite rotar la clave de cifrado sin perder los tokens existentes.
  keyVersion      Int      @default(1)
  updatedAt       DateTime @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("social_credentials")
}

/// Una métrica de un día para una cuenta. Solo existen filas que la API devolvió:
/// un día ausente significa "todavía no hay dato", y un 0 presente es un cero real.
model AccountDailyMetric {
  id              String   @id @default(uuid()) @db.Uuid
  socialAccountId String   @db.Uuid
  // Fecha del Pacífico a la que YouTube asigna el dato (sin hora ni zona).
  metricDate      DateTime @db.Date
  // Código del catálogo, p. ej. "views". Texto, para no migrar con cada plataforma.
  metric          String
  value           Float
  // Última vez que se escribió: los datos pueden corregirse días después.
  updatedAt       DateTime @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, metricDate, metric])
  @@index([socialAccountId, metricDate])
  @@map("account_daily_metrics")
}

/// Totales puntuales (suscriptores, vistas totales, videos). Como máximo uno por día
/// del Pacífico y métrica, para que repetir una sincronización no duplique.
model AccountTotalSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  socialAccountId String   @db.Uuid
  snapshotDate    DateTime @db.Date
  metric          String
  value           Float
  updatedAt       DateTime @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, snapshotDate, metric])
  @@map("account_total_snapshots")
}

/// Registro de cada sincronización, para consultar su estado.
model SyncRun {
  id              String     @id @default(uuid()) @db.Uuid
  socialAccountId String     @db.Uuid
  status          SyncStatus @default(RUNNING)
  startedAt       DateTime   @default(now())
  finishedAt      DateTime?
  rangeStart      DateTime   @db.Date
  rangeEnd        DateTime   @db.Date
  rowsWritten     Int        @default(0)
  // Siempre pasado por redactSecrets antes de guardarse.
  errorMessage    String?

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([socialAccountId, startedAt(sort: Desc)])
  @@map("sync_runs")
}